generator client {
  // prisma-client-js emits a ready-to-require JavaScript client (client.js +
  // client.d.ts). The newer "prisma-client" generator emits TypeScript only,
  // which the production entry (start.js) cannot require without a TS loader.
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AgentStatus {
  ACTIVE
  AWAY
  INACTIVE
  TERMINATED
}

enum UserRole {
  ADMIN
  HR
  LEADERSHIP
  READONLY
}

enum TaskModule {
  ACADEMY
  HR
  SRU
  AIR_SUPPORT
  DETECTIVE
  INTERNAL_AFFAIRS
  LAD
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AgentFlag {
  RED
  ORANGE
  YELLOW
  BLUE
}

enum SanctionStatus {
  OPEN
  PAID
  ESCALATED
  IN_COURT
}

enum CalendarEventType {
  TRAINING
  MEETING
  ACADEMY
  EXAM
  HR_DEADLINE
  SRU_TRAINING
  SRU_OPERATION
  AIR_SUPPORT_TRAINING
  AIR_SUPPORT_OPERATION
  OTHER
}

enum ProbationStatus {
  ACTIVE
  PASSED
  EXTENDED
  FAILED
}

enum ProbationType {
  ROOKIE
  SERGEANT_SUPERVISOR
  LEADERSHIP
  CHIEF
}

enum ProbationEntryRating {
  POSITIVE
  NEGATIVE
}

enum AcademyResourceType {
  FILE
  LINK
}

enum AcademyResourceScope {
  GENERAL
  TRAINING
}

enum FormTestStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FormTestKind {
  TEST
  SURVEY
}

enum FormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
}

enum JobApplicationStatus {
  SUBMITTED
  IN_REVIEW
  HR_INTERVIEW
  ACCEPTED
  REJECTED
}

enum PressReleaseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  CANCELLED
}

enum LegalCaseKind {
  SANCTION
  CUSTOM
}

enum LegalCaseStatus {
  DRAFT
  FILED
  CLOSED
}

model UserGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  memberships UserGroupMembership[]
}

model User {
  id                   String     @id @default(cuid())
  username             String     @unique
  passwordHash         String?
  displayName          String
  discordId            String?
  discordUsername      String?
  discordGlobalName    String?
  discordAvatar        String?
  discordDiscriminator String?
  lastLoginAt          DateTime?
  role                 UserRole   @default(READONLY)
  groupId              String?
  group                UserGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  permissions          Json?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  codenamesCreated  Codename[]           @relation("CodenameCreator")
  codenamesAssigned CodenameAssignment[] @relation("CodenameAssigner")
  codenamesReleased CodenameAssignment[] @relation("CodenameReleaser")

  groupMemberships           UserGroupMembership[]
  promotionsPerformed        PromotionLog[]            @relation("PerformedBy")
  terminationsPerformed      Termination[]             @relation("TerminatedBy")
  sanctionsIssued            Sanction[]                @relation("SanctionIssuedBy")
  notesAuthored              Note[]                    @relation("NoteAuthor")
  auditLogs                  AuditLog[]                @relation("AuditUser")
  createdLists               RankChangeList[]          @relation("ListCreator")
  rankChangeEntriesCreated   RankChangeListEntry[]     @relation("EntryCreator")
  rankChangeEntriesExecuted  RankChangeListEntry[]     @relation("EntryExecutor")
  rankChangeVotes            RankChangeVote[]
  rankChangeComments         RankChangeEntryComment[]  @relation("RankChangeCommentAuthor")
  rankChangeProposals        RankChangeEntryProposal[] @relation("RankChangeProposalAuthor")
  rankChangeReviews          RankChangeEntryProposal[] @relation("RankChangeProposalReviewer")
  rankChangeHistory          RankChangeEntryHistory[]  @relation("RankChangeHistoryActor")
  taskListsCreated           TaskList[]                @relation("TaskListCreator")
  tasksCreated               Task[]                    @relation("TaskCreator")
  calendarEventsCreated      CalendarEvent[]           @relation("CalendarEventCreator")
  sruFoldersCreated          SruFolder[]               @relation("SruFolderCreator")
  sruDocumentsCreated        SruDocument[]             @relation("SruDocumentCreator")
  sruDocumentsUpdated        SruDocument[]             @relation("SruDocumentUpdater")
  probationsCreated          Probation[]               @relation("ProbationCreator")
  probationsDecided          Probation[]               @relation("ProbationDecider")
  probationEntriesCreated    ProbationEntry[]          @relation("ProbationEntryCreator")
  apiTokensOwned             ApiToken[]                @relation("ApiTokenOwner")
  apiTokensCreated           ApiToken[]                @relation("ApiTokenCreator")
  academyResourcesCreated    AcademyResource[]         @relation("AcademyResourceCreator")
  formTestsCreated           FormTest[]                @relation("FormTestCreator")
  formResponsesSubmitted     FormResponse[]            @relation("FormResponseRespondent")
  formResponsesReviewed      FormResponse[]            @relation("FormResponseReviewer")
  formTestSessions           FormTestSession[]         @relation("FormTestSessionUser")
  jobApplicationsSubmitted   JobApplication[]          @relation("JobApplicationApplicant")
  jobApplicationsReviewed    JobApplication[]          @relation("JobApplicationReviewer")
  pressReleasesCreated       PressRelease[]            @relation("PressReleaseCreator")
  pressReleasesUpdated       PressRelease[]            @relation("PressReleaseUpdater")
  ordnungenCreated           Ordnung[]                 @relation("OrdnungCreator")
  unitAssignments            UserUnitAssignment[]
  contractTemplatesCreated   ContractTemplate[]        @relation("ContractTemplateCreator")
  contractsCreated           Contract[]                @relation("ContractCreator")
  contractsSigned            Contract[]                @relation("ContractSigner")
  agentSearchesCreated       AgentSearch[]             @relation("AgentSearchCreator")
  internalAffairsDawsCreated InternalAffairsDaw[]      @relation("IaDawCreator")
  legalCasesCreated          LegalCase[]               @relation("LegalCaseCreator")
  legalCaseBatchesCreated    LegalCaseBatch[]          @relation("LegalCaseBatchCreator")
  transferRequestsCreated    TransferRequest[]         @relation("TransferRequestCreator")
  transferRequestsSignedHr   TransferRequest[]         @relation("TransferRequestHrSigner")
  transferRequestsSignedOf   TransferRequest[]         @relation("TransferRequestAgentSigner")
  changeSets                 ChangeSet[]

  investigationsCreated        Investigation[]         @relation("InvestigationCreator")
  investigationAssignmentsMade InvestigationAssignee[] @relation("InvestigationAssigneeCreator")
  investigationEntriesCreated  InvestigationEntry[]    @relation("InvestigationEntryCreator")
  investigationClipsUploaded   BodycamClip[]           @relation("BodycamClipUploader")
  personsCreated               Person[]                @relation("PersonCreator")
  evidenceCreated              Evidence[]              @relation("EvidenceCreator")
  vehiclesCreated              Vehicle[]               @relation("VehicleCreator")
  personLinksCreated           PersonLink[]            @relation("PersonLinkCreator")
  investigationLinksCreated    InvestigationLink[]     @relation("InvestigationLinkCreator")
}

model UserGroupMembership {
  userId    String
  groupId   String
  source    String   @default("discord") // 'discord' | 'manual'
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@index([userId, source])
}

model Unit {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?  @db.Text
  color            String   @default("#d4af37")
  icon             String   @default("briefcase")
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  showInNavigation Boolean  @default(false)
  /// Auswählbare Funktionsbereiche inkl. Zugriffsstufe, z. B. {"academy":"manage"}.
  /// Nullable, damit additive MariaDB-Updates bestehende Zeilen nicht mit leerem, ungültigem JSON füllen.
  modules          Json?
  /// Zusätzliche Rechte, die diese Unit ihren Mitgliedern gewährt (analog UserGroup.permissions).
  permissions      Json     @default("[]")
  /// Optionaler Discord-Rang dieser konkreten Unterunit (z. B. "HR Senior Officer").
  discordRoleId    String?
  /// Zugehörige Unitgruppe. Gruppierte Units erben Module, Rechte und Navigation von der Gruppe.
  groupId          String?
  /// Leitungs-Unterunits erhalten automatisch Leitungsrecht und die gemeinsame Leitungsrolle der Gruppe.
  isLeadership     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userAssignments UserUnitAssignment[]
  group           UnitGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId, sortOrder])
}

/// Übergeordnete fachliche Unit. Sie bündelt beliebig viele Unterunits/Ränge
/// und steuert deren gemeinsame Module, Navigation und Discord-Rollen.
model UnitGroup {
  id                      String   @id @default(cuid())
  key                     String   @unique
  name                    String
  description             String?  @db.Text
  color                   String   @default("#d4af37")
  icon                    String   @default("briefcase")
  sortOrder               Int      @default(0)
  active                  Boolean  @default(true)
  showInNavigation        Boolean  @default(false)
  modules                 Json?
  permissions             Json     @default("[]")
  /// Gemeinsame Discord-Rolle für alle Mitglieder eines Unterrangs dieser Gruppe.
  memberDiscordRoleId     String?
  /// Gemeinsame Discord-Rolle für Mitglieder aller als Leitung markierten Unterränge.
  leadershipDiscordRoleId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  units Unit[]

  @@index([active, sortOrder])
}

/// Direkte Zuweisung einer Unit an einen Login-User (unabhängig vom Agent-Status).
model UserUnitAssignment {
  userId    String
  unitId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
}

model Rank {
  id             String   @id @default(cuid())
  name           String   @unique
  sortOrder      Int
  /// Interne, sichtbare Rangnummer (z. B. Chief of Police = Rang 19). Unabhängig von der Sortierung.
  internalNumber Int?     @unique
  color          String   @default("#3B82F6")
  /// Inklusiver Zahlenbereich für Dienstnummern (nur Ziffern / Prefix+Ziffern). Null = kein autom. Bereich.
  badgeMin       Int?
  badgeMax       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agents              Agent[]
  minimumForTrainings Training[]            @relation("TrainingMinimumRank")
  oldRankLogs         PromotionLog[]        @relation("OldRank")
  newRankLogs         PromotionLog[]        @relation("NewRank")
  entryCurrentRanks   RankChangeListEntry[] @relation("EntryCurrentRank")
  entryProposedRanks  RankChangeListEntry[] @relation("EntryProposedRank")
  tierRanks           TierRank[]
}

/// Eine "Ebene" = eine Discord-Rolle, die Agent automatisch erhalten, wenn ihr
/// Rang einer der zugewiesenen Ränge ist. Voll gemanaged (add + remove) über den
/// bestehenden Agent-Discord-Sync.
model Tier {
  id            String   @id @default(cuid())
  name          String   @unique
  /// Discord-Snowflake der Ebenen-Rolle. Null = (noch) keine Rolle hinterlegt.
  discordRoleId String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ranks TierRank[]
}

model TierRank {
  tierId String
  /// Ein Rang gehört zu genau EINER Ebene (global unique).
  rankId String @unique
  tier   Tier   @relation(fields: [tierId], references: [id], onDelete: Cascade)
  rank   Rank   @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@id([tierId, rankId])
  @@index([rankId])
}

model Training {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  sortOrder Int      @default(0)
  minRankId String?
  minRank   Rank?    @relation("TrainingMinimumRank", fields: [minRankId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  agentTrainings   AgentTraining[]
  academyResources AcademyResource[]

  @@index([minRankId])
}

model AcademyResource {
  id                 String               @id @default(cuid())
  scope              AcademyResourceScope
  type               AcademyResourceType
  title              String
  description        String?              @db.Text
  trainingId         String?
  training           Training?            @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  customTrainingName String?
  url                String?              @db.Text
  storedFilename     String?
  originalFilename   String?
  mimeType           String?
  size               Int?
  createdById        String?
  createdBy          User?                @relation("AcademyResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([scope, createdAt])
  @@index([trainingId, createdAt])
  @@index([createdById])
}

model FormTest {
  id                 String         @id @default(cuid())
  module             TaskModule
  kind               FormTestKind   @default(TEST)
  title              String
  description        String?        @db.Text
  status             FormTestStatus @default(DRAFT)
  timeLimitMinutes   Int?
  anonymousResponses Boolean        @default(false)
  shareToken         String         @unique
  createdById        String?
  createdBy          User?          @relation("FormTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  questions FormQuestion[]
  responses FormResponse[]
  sessions  FormTestSession[]

  @@index([module, status, updatedAt])
  @@index([createdById])
}

model FormQuestion {
  id          String           @id @default(cuid())
  testId      String
  test        FormTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  type        FormQuestionType
  title       String           @db.Text
  description String?          @db.Text
  required    Boolean          @default(true)
  options     Json?
  points      Int              @default(0)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  answers FormAnswer[]

  @@index([testId, sortOrder])
}

model FormResponse {
  id             String    @id @default(cuid())
  testId         String
  test           FormTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  respondentId   String?
  respondent     User?     @relation("FormResponseRespondent", fields: [respondentId], references: [id], onDelete: SetNull)
  respondentName String
  submitterHash  String?
  score          Int?
  maxScore       Int       @default(0)
  reviewNote     String?   @db.Text
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?     @relation("FormResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt    DateTime  @default(now())

  answers FormAnswer[]

  @@unique([testId, respondentId])
  @@index([testId, submitterHash])
  @@index([testId, submittedAt])
  @@index([respondentId, submittedAt])
  @@index([submitterHash])
  @@index([reviewedById])
}

model FormTestSession {
  id             String    @id @default(cuid())
  testId         String
  test           FormTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation("FormTestSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime?
  completedAt    DateTime?
  lastSeenAt     DateTime  @default(now())
  securityEvents Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, completedAt, expiresAt])
  @@index([testId, userId, startedAt])
}

model FormAnswer {
  id         String       @id @default(cuid())
  responseId String
  response   FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      Json
  createdAt  DateTime     @default(now())

  @@unique([responseId, questionId])
  @@index([questionId])
}

model JobApplication {
  id                   String               @id @default(cuid())
  /// Aktenzeichen der Bewerbung (z. B. "BW-0001"). Wird beim Einreichen
  /// vergeben und ist die Kennung, unter der HR die Bewerbung sucht. Optional,
  /// weil Bewerbungen aus der Zeit vor dieser Funktion noch keins haben.
  caseNumber           String?              @unique @db.VarChar(24)
  /// Zeitpunkt des letzten Umbenennungsversuchs (Anzeigename + Discord-Nickname).
  /// Gesetzt wird er auch bei einem Fehlschlag — sonst würde der Sammellauf
  /// ewig an denselben Bewerbern hängen bleiben.
  nicknameSyncedAt     DateTime?
  applicantId          String               @unique
  applicant            User                 @relation("JobApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  discordId            String
  discordUsername      String?
  discordGlobalName    String?
  discordAvatar        String?
  applicantDisplayName String
  status               JobApplicationStatus @default(SUBMITTED)
  statusText           String               @default("Bewerbung wurde eingereicht") @db.VarChar(500)
  internalNote         String?              @db.Text
  submittedAt          DateTime             @default(now())
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?                @relation("JobApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Agent, der aus dieser Bewerbung eingestellt wurde. Wird beim Anlegen des
  /// Agents gesetzt und macht Bewerbung ↔ Personalakte gegenseitig auffindbar.
  agentId              String?              @unique
  agent                Agent?               @relation("AgentJobApplication", fields: [agentId], references: [id], onDelete: SetNull)
  updatedAt            DateTime             @updatedAt

  answers   JobApplicationAnswer[]
  contracts Contract[]             @relation("JobApplicationContracts")

  @@index([status, updatedAt])
  @@index([submittedAt])
  @@index([discordId])
  @@index([reviewedById])
}

model JobApplicationAnswer {
  id            String           @id @default(cuid())
  applicationId String
  application   JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  questionTitle String           @db.Text
  questionType  FormQuestionType
  value         Json
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())

  @@unique([applicationId, questionId])
  @@index([applicationId, sortOrder])
}

model PressRelease {
  id          String             @id @default(cuid())
  title       String
  slug        String             @unique
  summary     String?            @db.Text
  content     String             @db.Text
  imageUrl    String?            @db.Text
  imageAlt    String?
  status      PressReleaseStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String?
  createdBy   User?              @relation("PressReleaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?              @relation("PressReleaseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([createdById])
  @@index([updatedById])
}

model Agent {
  id               String      @id @default(cuid())
  badgeNumber      String
  /// Discord-Snowflake (nur Dashboard / Verknüpfung; ohne Bot-Anbindung)
  discordId        String?     @unique
  firstName        String
  lastName         String
  rankId           String
  rank             Rank        @relation(fields: [rankId], references: [id])
  status           AgentStatus @default(ACTIVE)
  unit             String?
  units            Json?
  flag             AgentFlag?
  /// Uprank-Sperre: blockiert Beförderungen (Aufstieg). Degradierungen bleiben erlaubt.
  promotionBlocked Boolean     @default(false)
  notes            String?
  hireDate         DateTime    @default(now())
  lastOnline       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  codename            Codename?            @relation("CodenameCurrentHolder")
  codenameAssignments CodenameAssignment[] @relation("CodenameAssignments")

  trainings                AgentTraining[]
  promotionLogs            PromotionLog[]
  terminations             Termination[]
  sanctions                Sanction[]
  agentNotes               Note[]                  @relation("AgentNotes")
  auditLogs                AuditLog[]              @relation("AuditAgent")
  rankChangeEntries        RankChangeListEntry[]
  taskAssignments          TaskAssignment[]        @relation("TaskAssigned")
  dutySessions             DutyTimeSession[]
  playtimeSessions         PlaytimeSession[]
  absenceNotices           AbsenceNotice[]
  probations               Probation[]
  calendarEvents           CalendarEvent[]         @relation("CalendarEventAgent")
  contracts                Contract[]
  jobApplication           JobApplication?         @relation("AgentJobApplication")
  transferRequests         TransferRequest[]       @relation("AgentTransferRequests")
  searches                 AgentSearch[]
  internalAffairsDaws      InternalAffairsDaw[]
  legalCases               LegalCase[]             @relation("AgentLegalCases")
  investigationsLed        Investigation[]         @relation("InvestigationLeadAgent")
  investigationAssignments InvestigationAssignee[] @relation("InvestigationAssigneeAgent")
  bodycamClips             BodycamClip[]           @relation("BodycamClipRecorder")
  evidenceSeized           Evidence[]              @relation("EvidenceSeizedBy")

  @@index([badgeNumber])
}

/// Chronologischer Internal-Affairs-Eintrag zu einer durchgeführten
/// Agent-Durchsuchung. Der erfassende Benutzer wird automatisch gespeichert.
model AgentSearch {
  id                   String   @id @default(cuid())
  agentId              String
  agent                Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conductedAt          DateTime
  prohibitedItemsFound Boolean  @default(false)
  foundItems           String   @db.Text
  notes                String?  @db.Text
  createdById          String?
  createdBy            User?    @relation("AgentSearchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())

  @@index([agentId, conductedAt])
  @@index([createdById])
}

/// Dienstaufsichtswarnungen, Disziplinarakten und Ermittlungen von Internal Affairs
model InternalAffairsDaw {
  id                  String    @id @default(cuid())
  caseNumber          String?
  title               String
  category            String    @default("DAW") // DAW, DISCIPLINARY, INSTRUCTION, INVESTIGATION, OTHER
  agentId             String?
  agent               Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  allegation          String?   @db.Text
  statement           String?   @db.Text
  penalGrade          String?
  sanctionSummary     String?   @db.Text
  fineAmount          Int?
  sgRounds            Int?
  suspensionHours     Int?
  status              String    @default("OPEN") // OPEN, IN_REVIEW, SANCTIONED, RESOLVED, DISMISSED
  evidence            Json?
  incidentAt          DateTime?
  deadlineAt          DateTime?
  resolutionNote      String?   @db.Text
  createdById         String?
  createdBy           User?     @relation("IaDawCreator", fields: [createdById], references: [id], onDelete: SetNull)
  previousRank        String?
  previousBadgeNumber String?
  previousFirstName   String?
  previousLastName    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([agentId, createdAt])
  @@index([createdById])
  @@index([status, createdAt])
}

model CalendarEvent {
  id                  String            @id @default(cuid())
  module              TaskModule?
  title               String
  description         String?           @db.Text
  type                CalendarEventType @default(OTHER)
  startsAt            DateTime
  endsAt              DateTime?
  location            String?
  agentId             String?
  agent               Agent?            @relation("CalendarEventAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdById         String?
  createdBy           User?             @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  discordAnnouncement Boolean           @default(false)
  discordChannelId    String?
  discordMessageId    String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([startsAt])
  @@index([module, startsAt])
  @@index([type, startsAt])
  @@index([agentId, startsAt])
}

model SruFolder {
  id          String     @id @default(cuid())
  module      TaskModule @default(SRU)
  name        String
  description String?    @db.Text
  color       String     @default("#d4af37")
  sortOrder   Int        @default(0)
  createdById String?
  createdBy   User?      @relation("SruFolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  documents SruDocument[]

  @@index([module, sortOrder, createdAt])
}

model SruDocument {
  id          String     @id @default(cuid())
  module      TaskModule @default(SRU)
  folderId    String?
  folder      SruFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title       String
  content     String     @db.Text
  /// Optionaler externer Dokument-Link. Wird direkt im Browser geöffnet;
