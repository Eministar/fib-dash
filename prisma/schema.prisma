/// Wiederverwendbare Vertragsvorlage (z. B. Arbeitsvertrag). Der Inhalt ist
/// Markdown mit Platzhaltern (`{{vorname}}`, `{{dienstnummer}}`, …), die beim
/// Erstellen eines Vertrags gegen die Agent-Daten aufgelöst werden.
model ContractTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  /// Präambel des Dokuments (Markdown, oberhalb der Regelungen).
  content     String   @db.Text
  /// ContractClause[] — einzeln bearbeitbare Regelungen (§ 1, § 2, …).
  clauses     Json     @default("[]")
  /// Abschlusstext unterhalb der Regelungen (Markdown).
  closing     String?  @db.Text
  /// ContractField[] — Felder, die der Unterzeichner ausfüllt (inkl. Unterschrift).
  fields      Json     @default("[]")
  active      Boolean  @default(true)
  /// Vorlage, die beim Anlegen eines Agents automatisch verwendet wird.
  isDefault   Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("ContractTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]

  @@index([active, updatedAt])
  @@index([createdById])
}

/// Ein konkreter Vertrag für genau einen Agent. `content`/`fields` sind
/// Snapshots der Vorlage zum Erstellungszeitpunkt — spätere Änderungen an der
/// Vorlage dürfen einen bereits versendeten oder unterschriebenen Vertrag nicht
/// nachträglich verändern.
model Contract {
  id            String            @id @default(cuid())
  templateId    String?
  template      ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  agentId       String
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  applicationId String?
  application   JobApplication?   @relation("JobApplicationContracts", fields: [applicationId], references: [id], onDelete: SetNull)

  title   String
  content String  @db.Text
  clauses Json    @default("[]")
  closing String? @db.Text
  fields  Json    @default("[]")
  /// Vom Unterzeichner eingetragene Werte: `{ [fieldId]: string | boolean }`.
  values  Json?

  status ContractStatus @default(DRAFT)
  /// Persönlicher Link-Token — jeder Agent bekommt seinen eigenen Vertragslink.
  token  String         @unique

  /// Discord-ID, die unterschreiben darf (Snapshot des Agents bei Erstellung).
  signerDiscordId String?

  sentAt        DateTime?
  /// 'dm' | 'channel' — wie die letzte Vertragsnachricht zugestellt wurde.
  sentVia       String?
  sentChannelId String?
  sentMessageId String?
  sendCount     Int       @default(0)
  lastSendError String?   @db.Text

  signedAt        DateTime?
  signedName      String?
  signedByUserId  String?
  signedBy        User?     @relation("ContractSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  signedIp        String?   @db.VarChar(64)
  signedUserAgent String?   @db.VarChar(200)

  declinedAt    DateTime?
  declineReason String?   @db.Text

  createdById String?
  createdBy   User?    @relation("ContractCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([status, updatedAt])
  @@index([applicationId])
  @@index([templateId])
  @@index([createdById])
  @@index([signedByUserId])
}

// ---------------------------------------------------------------------------
// Versetzungsanträge
// ---------------------------------------------------------------------------

enum TransferRequestStatus {
  DRAFT
  SENT
  IN_SIGNING
  COMPLETED
  DECLINED
  CANCELLED
}

/// Versetzungsantrag als Dokument mit drei Unterschriften: FIB (HR), der
/// Beamte selbst und die entgegennehmende Behörde. Wird über einen Link
/// ausgefüllt, der bewusst auch ohne Login geöffnet werden kann.
model TransferRequest {
  id            String @id @default(cuid())
  token         String @unique
  /// Aktenzeichen des Antrags, z. B. "VA-0001".
  requestNumber String @unique @db.VarChar(24)

  agentId         String?
  agent           Agent?  @relation("AgentTransferRequests", fields: [agentId], references: [id], onDelete: SetNull)
  /// Snapshots des Beamten zum Erstellungszeitpunkt.
  agentName       String
  badgeNumber     String?
  rankName        String?
  /// Discord-ID, die als Beamter unterschreiben darf.
  signerDiscordId String?

  title   String
  content String  @db.Text
  clauses Json    @default("[]")
  closing String? @db.Text
  fields  Json    @default("[]")
  /// Vom Antragsteller eingetragene Werte: `{ [fieldId]: string | boolean }`.
  values  Json?

  /// Entgegennehmende Behörde (Ziel der Versetzung).
  targetAuthority String?

  status TransferRequestStatus @default(DRAFT)

  hrSignedName     String?
  hrSignedAt       DateTime?
  hrSignedByUserId String?
  hrSignedBy       User?     @relation("TransferRequestHrSigner", fields: [hrSignedByUserId], references: [id], onDelete: SetNull)

  agentSignedName     String?
  agentSignedAt       DateTime?
  agentSignedByUserId String?
  agentSignedBy       User?     @relation("TransferRequestAgentSigner", fields: [agentSignedByUserId], references: [id], onDelete: SetNull)

  authoritySignedName String?
  authoritySignedRole String?
  authoritySignedAt   DateTime?
  authoritySignedIp   String?   @db.VarChar(64)

  sentAt        DateTime?
  declinedAt    DateTime?
  declineReason String?   @db.Text

  createdById String?
  createdBy   User?    @relation("TransferRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([agentId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Legal Affairs Division — Klagen
// ---------------------------------------------------------------------------

/// Eine Klage (Klageschrift) der Legal Affairs Division. Jede Klageschrift
/// hat einen eigenen Link (`token`), über den sie ohne Anmeldung eingesehen
/// werden kann. `kind=SANCTION` wird beim Erstellen automatisch aus den
/// ausgewählten offenen Sanktionen generiert; `kind=CUSTOM` ist frei verfasst.
model LegalCase {
  id         String          @id @default(cuid())
  /// Aktenzeichen der Klage, z. B. "LAD-0001".
  caseNumber String          @unique @db.VarChar(24)
  /// Link-Token für die öffentliche Einsicht.
  token      String          @unique
  kind       LegalCaseKind   @default(CUSTOM)
  status     LegalCaseStatus @default(DRAFT)
  title      String

  /// Beklagter (Agent). Snapshot-Felder bleiben erhalten, wenn der Agent
  /// später gelöscht wird.
  agentId String?
  agent   Agent?  @relation("AgentLegalCases", fields: [agentId], references: [id], onDelete: SetNull)

  accusedName      String? @db.VarChar(200)
  accusedBadge     String? @db.VarChar(64)
  accusedRank      String? @db.VarChar(120)
  accusedDiscordId String? @db.VarChar(64)

  /// Betreff der Klageschrift.
  subject String  @db.Text
  /// Sachverhalt (Markdown).
  content String  @db.Text
  /// Antrag / Schlusstext (Markdown).
  closing String? @db.Text

  /// Snapshot der als Beweismittel verknüpften Sanktionen:
  /// `[{ sanctionId, reason, penalGrade, measureType, fineAmount, sgRounds, createdAt, dueAt }]`.
  sanctions Json @default("[]")

  filedAt     DateTime?
  closedAt    DateTime?
  createdById String?
  createdBy   User?     @relation("LegalCaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Zugehörige Sammelaktion ("Alle offenen Sanktionen gekündigter Mitarbeiter").
  batchId String?
  batch   LegalCaseBatch? @relation("LegalCaseBatchCases", fields: [batchId], references: [id], onDelete: SetNull)

  linkedSanctions Sanction[] @relation("SanctionLegalCase")

  @@index([status, updatedAt])
  @@index([agentId])
  @@index([createdById])
  @@index([batchId])
}

/// Eine Sammelaktion der Legal Affairs Division: erzeugt für jeden gekündigten
/// Mitarbeiter mit offenen Sanktionen genau eine Sanktionsklage. Der eigene
/// Link-Token öffnet eine Übersicht aller enthaltenen Klageschriften.
model LegalCaseBatch {
  id          String   @id @default(cuid())
  token       String   @unique
  title       String   @default("Sammelklagen – Offene Sanktionen gekündigter Mitarbeiter")
  createdById String?
  createdBy   User?    @relation("LegalCaseBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  cases LegalCase[] @relation("LegalCaseBatchCases")

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Einsatzakten- und Ermittlungssystem
// ---------------------------------------------------------------------------

enum InvestigationStatus {
  OPEN
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum InvestigationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// Art eines Chronologie-Eintrags innerhalb einer Ermittlungsakte.
enum InvestigationEntryKind {
  OPERATION
  INTERROGATION
  OBSERVATION
  EVIDENCE
  NOTE
  RESULT
}

enum InvestigationPersonRole {
  SUSPECT
  WITNESS
  VICTIM
  INFORMANT
  ACCOMPLICE
  OTHER
}

/// Eine Ermittlungsakte. Bündelt die Chronologie der Einsätze, die beteiligten
/// Personen und die zugehörigen Bodycam-Clips unter einem Aktenzeichen.
model Investigation {
  id         String                @id @default(cuid())
  /// Fortlaufendes Aktenzeichen, z. B. "ERM-0001".
  caseNumber String                @unique @db.VarChar(24)
  title      String                @db.VarChar(200)
  /// Zusammenfassung der Ermittlungslage (Markdown).
  summary    String?               @db.Text
  status     InvestigationStatus   @default(OPEN)
  priority   InvestigationPriority @default(NORMAL)

  /// Verschlusssache: nur Ersteller, Fallführung, zugewiesene Ermittler und
  /// Inhaber von `investigations:classified` sehen die Akte samt Clips.
  classified Boolean @default(false)

  /// Fallführender Agent.
  leadAgentId String?
  leadAgent   Agent?  @relation("InvestigationLeadAgent", fields: [leadAgentId], references: [id], onDelete: SetNull)

  closedAt    DateTime?
  createdById String?
  createdBy   User?     @relation("InvestigationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignees InvestigationAssignee[]
  entries   InvestigationEntry[]
  persons   InvestigationPerson[]
  clips     BodycamClip[]
  evidence  Evidence[]
  vehicles  InvestigationVehicle[]
  linksFrom InvestigationLink[]     @relation("InvestigationLinkFrom")
  linksTo   InvestigationLink[]     @relation("InvestigationLinkTo")

  @@index([status, updatedAt])
  @@index([priority, updatedAt])
  @@index([leadAgentId])
  @@index([createdById])
}

/// Zusätzlich zugewiesene Ermittler. Sie behalten Zugriff auf Verschlusssachen.
model InvestigationAssignee {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  /// Zugewiesener Ermittler. Der Zugriff wird – wie bei der Fallfuehrung –
  /// ueber die Discord-ID auf das Dashboard-Konto aufgeloest.
  agentId         String
  agent           Agent         @relation("InvestigationAssigneeAgent", fields: [agentId], references: [id], onDelete: Cascade)
  /// Wer die Zuweisung vorgenommen hat.
  addedById       String?
  addedBy         User?         @relation("InvestigationAssigneeCreator", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@unique([investigationId, agentId])
  @@index([agentId])
  @@index([addedById])
}

/// Ein Einsatz oder Ermittlungsschritt in der Chronologie einer Akte.
model InvestigationEntry {
  id              String                 @id @default(cuid())
  investigationId String
  investigation   Investigation          @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  kind            InvestigationEntryKind @default(OPERATION)
  title           String                 @db.VarChar(200)
  /// Hergang / Feststellungen (Markdown).
  content         String?                @db.Text
  /// Zeitpunkt des Einsatzes – bewusst getrennt von `createdAt`, weil Akten
  /// regelmäßig nachträglich gepflegt werden.
  occurredAt      DateTime
  location        String?                @db.VarChar(200)
  /// Snapshot der beteiligten Agents: `[{ agentId, name, badgeNumber, rank }]`.
  participants    Json                   @default("[]")

  createdById String?
  createdBy   User?    @relation("InvestigationEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clips    BodycamClip[]
  evidence Evidence[]

  @@index([investigationId, occurredAt])
  @@index([kind])
}

/// Fallübergreifendes Personenregister (Zivilisten, keine FIB-Agents).
model Person {
  id           String    @id @default(cuid())
  /// Fortlaufende Personenaktennummer, z. B. "PER-0001".
  personNumber String    @unique @db.VarChar(24)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  alias        String?   @db.VarChar(100)
  /// Ausweis-/Spielerkennung.
  identifier   String?   @db.VarChar(100)
  dateOfBirth  DateTime?
  phone        String?   @db.VarChar(64)
  photoUrl     String?   @db.VarChar(2048)
  /// Freie Notizen (Markdown).
  notes        String?   @db.Text
  wanted       Boolean   @default(false)
  dangerous    Boolean   @default(false)

  createdById String?
  createdBy   User?    @relation("PersonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investigations InvestigationPerson[]
  vehiclesOwned  Vehicle[]             @relation("VehicleOwner")
  linksFrom      PersonLink[]          @relation("PersonLinkFrom")
  linksTo        PersonLink[]          @relation("PersonLinkTo")

  @@index([lastName, firstName])
  @@index([wanted])
}

/// Verknüpfung Akte ↔ Person mit der Rolle in genau dieser Ermittlung.
model InvestigationPerson {
  id              String                  @id @default(cuid())
  investigationId String
  investigation   Investigation           @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  personId        String
  person          Person                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role            InvestigationPersonRole @default(SUSPECT)
  note            String?                 @db.Text
  createdAt       DateTime                @default(now())

  @@unique([investigationId, personId, role])
  @@index([personId])
}

/// Hochgeladener Bodycam-Clip. Die Datei liegt unter `CLIP_DIR`, ausgeliefert
/// wird sie ausschließlich über die geschützte Streaming-Route.
model BodycamClip {
  id              String              @id @default(cuid())
  investigationId String
  investigation   Investigation       @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  /// Optionale Zuordnung zu einem Chronologie-Eintrag.
  entryId         String?
  entry           InvestigationEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  title       String    @db.VarChar(200)
  description String?   @db.Text
  recordedAt  DateTime?
  location    String?   @db.VarChar(200)

  /// Gespeicherter Dateiname (`<uuid><ext>`), nie der Originalname.
  filename        String @unique @db.VarChar(80)
  originalName    String @db.VarChar(255)
  sizeBytes       BigInt
  mimeType        String @db.VarChar(120)
  durationSeconds Int?

  /// Agent, dessen Bodycam die Aufnahme stammt.
  recordedByAgentId String?
  recordedByAgent   Agent?  @relation("BodycamClipRecorder", fields: [recordedByAgentId], references: [id], onDelete: SetNull)

  /// Freie Schlagworte: `["Zugriff", "Schusswaffengebrauch"]`.
  tags Json @default("[]")

  uploadedById String?
  uploadedBy   User?    @relation("BodycamClipUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([investigationId, recordedAt])
  @@index([entryId])
  @@index([recordedByAgentId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Ermittlungswerkzeuge: Asservate, Fahrzeuge, Verbindungen
// ---------------------------------------------------------------------------

enum EvidenceKind {
  WEAPON
  DRUGS
  MONEY
  DOCUMENT
  ELECTRONICS
  CLOTHING
  BIOLOGICAL
  VEHICLE_PART
  OTHER
}

enum EvidenceStatus {
  SECURED
  IN_ANALYSIS
  RELEASED
  DESTROYED
  LOST
}

/// Ein sichergestelltes Asservat. Haengt an der Akte und optional am Einsatz,
/// bei dem es sichergestellt wurde.
model Evidence {
  id              String              @id @default(cuid())
  investigationId String
  investigation   Investigation       @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  entryId         String?
  entry           InvestigationEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  /// Fortlaufende Asservatennummer, z. B. "ASV-0001".
  itemNumber String         @unique @db.VarChar(24)
  kind       EvidenceKind   @default(OTHER)
  status     EvidenceStatus @default(SECURED)

  title       String  @db.VarChar(200)
  description String? @db.Text
  /// Stueckzahl bzw. Menge; die Einheit steht im Titel ("120 g Kokain").
  quantity    Int?

  seizedAt        DateTime?
  seizedLocation  String?   @db.VarChar(200)
  seizedByAgentId String?
  seizedByAgent   Agent?    @relation("EvidenceSeizedBy", fields: [seizedByAgentId], references: [id], onDelete: SetNull)
  /// Aktueller Verwahrort (Asservatenkammer, Labor, …).
  storageLocation String?   @db.VarChar(200)
  photoUrl        String?   @db.VarChar(2048)

  createdById String?
  createdBy   User?    @relation("EvidenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([investigationId, seizedAt])
  @@index([entryId])
  @@index([status])
}

/// Fallübergreifendes Fahrzeugregister.
model Vehicle {
  id            String  @id @default(cuid())
  /// Fortlaufende Registernummer, z. B. "FZG-0001".
  vehicleNumber String  @unique @db.VarChar(24)
  plate         String? @db.VarChar(32)
  model         String? @db.VarChar(120)
  color         String? @db.VarChar(60)
  notes         String? @db.Text
  stolen        Boolean @default(false)
  wanted        Boolean @default(false)

  /// Halter aus dem Personenregister.
  ownerPersonId String?
  ownerPerson   Person? @relation("VehicleOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("VehicleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investigations InvestigationVehicle[]

  @@index([plate])
  @@index([ownerPersonId])
}

/// Verknuepfung Akte ↔ Fahrzeug.
model InvestigationVehicle {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  note            String?       @db.Text
  createdAt       DateTime      @default(now())

  @@unique([investigationId, vehicleId])
  @@index([vehicleId])
}

enum PersonLinkType {
  FAMILY
  ASSOCIATE
  EMPLOYER
  RIVAL
  PARTNER
  MEMBER_OF
  CONTACT
  OTHER
}

/// Gerichtete Verbindung zwischen zwei Personen ("A ist Arbeitgeber von B").
/// Die Gegenrichtung wird beim Lesen mitgeladen, nicht doppelt gespeichert.
model PersonLink {
  id           String         @id @default(cuid())
  fromPersonId String
  fromPerson   Person         @relation("PersonLinkFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPersonId   String
  toPerson     Person         @relation("PersonLinkTo", fields: [toPersonId], references: [id], onDelete: Cascade)
  type         PersonLinkType @default(ASSOCIATE)
  note         String?        @db.Text

  createdById String?
  createdBy   User?    @relation("PersonLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([fromPersonId, toPersonId, type])
  @@index([toPersonId])
}

/// Querverweis zwischen zwei Ermittlungsakten.
model InvestigationLink {
  id     String        @id @default(cuid())
  fromId String
  from   Investigation @relation("InvestigationLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Investigation @relation("InvestigationLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  note   String?       @db.Text

  createdById String?
  createdBy   User?    @relation("InvestigationLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

model Codename {
  id             String               @id @default(cuid())
  name           String               @unique @db.VarChar(80)
  category       String?              @db.VarChar(40)
  retired        Boolean              @default(false)
  retiredReason  String?              @db.VarChar(200)
  currentAgentId String?              @unique
  currentAgent   Agent?               @relation("CodenameCurrentHolder", fields: [currentAgentId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?                @relation("CodenameCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  assignments    CodenameAssignment[]

  @@index([category])
  @@index([retired])
}

model CodenameAssignment {
  id            String    @id @default(cuid())
  codenameId    String
  codename      Codename  @relation(fields: [codenameId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent     @relation("CodenameAssignments", fields: [agentId], references: [id], onDelete: Cascade)
  assignedAt    DateTime  @default(now())
  releasedAt    DateTime?
  releaseReason String?   @db.VarChar(40)
  note          String?   @db.Text
  assignedById  String?
  assignedBy    User?     @relation("CodenameAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  releasedById  String?
  releasedBy    User?     @relation("CodenameReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([codenameId, assignedAt])
  @@index([agentId, assignedAt])
  @@index([releasedAt])
}
